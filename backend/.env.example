# ── Stripe (Workstream B) ───────────────────────────────────────────────────
# Secret API key from https://dashboard.stripe.com/apikeys (sk_test_… or sk_live_…)
STRIPE_SECRET_KEY=
# Webhook signing secret from the webhook endpoint you create (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Frontend origin Stripe Checkout returns to after pay/cancel
FRONTEND_URL=http://localhost:5173
# Optional: override the Price lookup_keys the code resolves (defaults shown).
# Leave unset if you name the Stripe Prices with the default lookup_keys below.
STRIPE_PRICE_INFLUENCE=capable_influence_monthly
STRIPE_PRICE_PRO=capable_pro_monthly
STRIPE_PRICE_DEPLOY_SLOT=capable_deploy_slot_monthly

# If STRIPE_SECRET_KEY is empty, billing routes fall back to simulated mode.

# ── Production hosting (Railway/Render) ──────────────────────────────────────
# Required: Postgres connection (Supabase).
DATABASE_URL=
# Persistent volume mount for published sites/thumbnails (survives redeploys).
HOSTED_DIR=/data/hosted
# Public base URL of THIS backend (used in published links). e.g. https://api.capable.live
BASE_URL=
# CORS allowlist for the frontend origin(s), comma-separated. e.g. https://capable.live
CORS_ORIGINS=
# Admin emails (comma-separated) auto-promoted to admin.
ADMIN_EMAILS=
# AI keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
JWT_SECRET=

# ── Domain purchasing (ResellerClub reseller API) ───────────────────────────
# Lets customers buy a domain from inside Capable's own UI (no redirect to an
# external, English-only registrar). Leave both blank to keep this feature off
# — /api/domains/search and /purchase report "not configured" and the
# "Buy a new domain" section stays hidden in the UI until this is set.
RESELLERCLUB_RESELLER_ID=
RESELLERCLUB_API_KEY=
# Set to "true" only after a full sandbox test cycle against test.httpapi.com
# (the default when this is unset) — see backend/src/domains/resellerclub.js.
RESELLERCLUB_LIVE=
# Nameservers to register new domains with, comma-separated. Leave unset to use
# ResellerClub's default parking nameservers (DNS is still pointed at Capable
# separately via pointDnsAtCapable, so the site works either way).
RESELLERCLUB_NAMESERVERS=
# Apex host purchased/BYO domains CNAME to — must match your production host.
CAPABLE_APEX=capable.app

# ── Social Ads Integrations (Meta/Instagram, TikTok, Snapchat Ads) ─────────
# Agency-managed ad account connections shown in Admin → Social Ads. Each
# platform is independent: leave a platform's CLIENT_ID/SECRET/REDIRECT_URI
# blank to keep that platform's "Connect" button hidden in the admin UI
# (never half-broken) — see backend/src/ads/*.js isConfigured().

# Meta Marketing API app — https://developers.facebook.com/apps
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
META_ADS_REDIRECT_URI=          # e.g. https://api.capable.live/api/admin/ads/callback/meta

# TikTok Business/Marketing API app — https://business-api.tiktok.com/portal
# (NOT the consumer Login Kit app). Requires TikTok app review before real
# advertisers outside your own account can authorize it.
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_REDIRECT_URI=        # e.g. https://api.capable.live/api/admin/ads/callback/tiktok

# Snapchat Marketing API app — apply for access at businesshelp.snapchat.com
SNAPCHAT_ADS_CLIENT_ID=
SNAPCHAT_ADS_CLIENT_SECRET=
SNAPCHAT_ADS_REDIRECT_URI=      # e.g. https://api.capable.live/api/admin/ads/callback/snapchat

# Encrypts stored ad-account access/refresh tokens at rest (AES-256-GCM, no
# new dependency — see backend/src/ads/tokenCrypto.js). Recommended in
# production; if unset, tokens are still encrypted but the key is derived
# from JWT_SECRET as a fallback (rotating JWT_SECRET would then also break
# stored ad tokens — set a dedicated key in production to avoid that).
ADS_TOKEN_ENCRYPTION_KEY=
